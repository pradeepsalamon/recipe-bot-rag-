# Copy to app/.env and fill in. Only GROQ_API_KEY is required.
GROQ_API_KEY=

# --- optional features (all off by default) ---
# PANTRY_CACHE=1              # semantic answer cache (never for allergy/diet/safety questions)
# PANTRY_LANGSMITH=1          # mirror redacted traces to LangSmith (needs the key below)
# LANGSMITH_API_KEY=

# --- optional overrides ---
# PANTRY_MODEL=openai/gpt-oss-20b
# PANTRY_REASONING_EFFORT=low
# PANTRY_MCP_TIMEOUT_S=30
# PANTRY_LOG_DIR=./logs
# PANTRY_LOG_MAX_BYTES=52428800
# PANTRY_LOG_RAW_QUERY=0      # 1 = log un-redacted questions (local debugging only: allergies are health data)
